# Copier en .env et adapter si besoin.

# Mode demonstration : aucun envoi reel, apercu uniquement.
DEMO_MODE=1

# Deux emplacements obligatoirement distincts. Ne jamais les inverser.
GARAGE_DB=data/garage.db
GARAGE_REAL_DB=data/garage-reel.db

# Redaction des messages : "mock" (gratuit, hors ligne) ou "anthropic" (API reelle).
LLM_MODE=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=1200

# Date de reference figee pour des captures reproductibles (AAAA-MM-JJ).
DEMO_TODAY=

# Graine du generateur : meme graine, memes montants.
DEMO_SEED=20260827
